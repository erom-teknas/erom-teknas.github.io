---
layout: null
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description | strip_newlines | strip }}",
  "icons": [
    { "src": "{{ '/assets/img/favicons/android-chrome-192x192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/img/favicons/android-chrome-384x384.png' | relative_url }}", "sizes": "384x384", "type": "image/png" }
  ],
  "start_url": "{{ '/' | relative_url }}",
  "theme_color": "#0b0d0e",
  "background_color": "#0b0d0e",
  "display": "browser"
}
